{
  "env": {
    "browser": true,
    "es2021": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:react/recommended"
  ],
  "overrides": [
    {
      "files": [
        "*.vue"
      ],
      "extends": [
        "eslint:recommended",
        "plugin:vue/vue3-essential"
      ],
      "parser": "vue-eslint-parser"
    }
  ],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "react/display-name": "off",
    "react/no-children-prop": "off",
    "react/prop-types": "off"
  }
}
